# ============================================================
# THE AGENTIC BLUEPRINT — Environment Variables
# ============================================================
# 
# HOW TO USE THIS FILE:
# 1. Copy this file and rename it to .env
# 2. Fill in every value marked REQUIRED
# 3. Never commit your .env file to GitHub
#    (it's already in .gitignore — don't remove it)
#
# If you see a value marked OPTIONAL — the system works
# without it. Add it when you're ready for that feature.
#
# ============================================================


# ------------------------------------------------------------
# YOUR BUSINESS
# ------------------------------------------------------------

# The name of your business — appears in SMS confirmations
# and the voice agent greeting
BUSINESS_NAME=Rich Off AI HVAC

# Your business phone number — the one customers call
# E.164 format: +1 followed by 10 digits, no spaces
BUSINESS_PHONE=+12392942140

# Your timezone — used for calendar bookings
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=America/New_York


# ------------------------------------------------------------
# VAPI — YOUR VOICE AGENT
# ------------------------------------------------------------
# Vapi is what makes the phone agent work.
# Sign up at vapi.ai, create an assistant, copy the keys here.

# REQUIRED — your Vapi private API key
VAPI_API_KEY=

# REQUIRED — the ID of the assistant you created in Vapi
VAPI_ASSISTANT_ID=

# REQUIRED — the webhook secret Vapi sends with every event
# Set this in your Vapi dashboard under Webhooks
VAPI_WEBHOOK_SECRET=


# ------------------------------------------------------------
# SUPABASE — YOUR DATABASE
# ------------------------------------------------------------
# Supabase stores every call, quote, booking, and SMS log.
# Sign up at supabase.com, create a project, copy the keys here.

# REQUIRED — your Supabase project URL
# Looks like: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# REQUIRED — your Supabase anon/public key
# Found in: Supabase dashboard → Settings → API
SUPABASE_ANON_KEY=

# REQUIRED — your Supabase service role key
# Found in: Supabase dashboard → Settings → API
# WARNING: This key bypasses row-level security.
# Never expose it in the frontend. Backend only.
SUPABASE_SERVICE_KEY=


# ------------------------------------------------------------
# ANTHROPIC — THE AI BRAIN
# ------------------------------------------------------------
# The AI models that power every agent in this system.
# Sign up at console.anthropic.com, create an API key.

# REQUIRED
ANTHROPIC_API_KEY=


# ------------------------------------------------------------
# TWILIO — SMS CONFIRMATIONS
# ------------------------------------------------------------
# Twilio sends the confirmation text to your customers.
# You already have Twilio numbers — use those credentials here.

# REQUIRED
TWILIO_ACCOUNT_SID=

# REQUIRED
TWILIO_AUTH_TOKEN=

# REQUIRED — the Twilio number that sends SMS confirmations
# Must be a Twilio number you own, E.164 format
TWILIO_FROM_NUMBER=


# ------------------------------------------------------------
# GOOGLE CALENDAR — JOB BOOKINGS
# ------------------------------------------------------------
# Jobs get written to Google Calendar so your technicians
# know when and where to show up.
#
# Setup guide: see harness/skills/calendar-booking/SKILL.md
# for step-by-step Google Calendar API setup instructions.

# REQUIRED — the email of the Google Calendar to write to
GOOGLE_CALENDAR_ID=

# REQUIRED — path to your Google service account credentials file
# Download from: Google Cloud Console → IAM → Service Accounts
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google-service-account.json


# ------------------------------------------------------------
# ADAPTER ROUTING — THE ONE-LINE SWAP
# ------------------------------------------------------------
# This is the adapter pattern in action.
# Change these two values to reroute the entire system.
# The agents never change. Only the destination changes.

# Where job records get written
# Options: supabase | ghl
CRM_DESTINATION=supabase

# Where bookings get written
# Options: google | ghl_calendar
CALENDAR_DESTINATION=google


# ------------------------------------------------------------
# GOHIGHLEVEL — OPTIONAL CRM
# ------------------------------------------------------------
# Only needed if CRM_DESTINATION=ghl or CALENDAR_DESTINATION=ghl_calendar
# Sign up at gohighlevel.com

# OPTIONAL — only needed if using GHL
GHL_API_KEY=

# OPTIONAL — your GHL location/sub-account ID
GHL_LOCATION_ID=

# OPTIONAL — your GHL calendar ID for bookings
GHL_CALENDAR_ID=


# ------------------------------------------------------------
# RAILWAY — YOUR DEPLOYMENT
# ------------------------------------------------------------
# Railway is where this system runs in production.
# These are set automatically by Railway — you don't need
# to fill them in locally. They're here so you know they exist.

# Set automatically by Railway
PORT=8000

# Set automatically by Railway
RAILWAY_ENVIRONMENT=production


# ------------------------------------------------------------
# DASHBOARD
# ------------------------------------------------------------
# The frontend dashboard that shows your calls, quotes,
# and bookings. Built with Lovable, deployed separately.

# OPTIONAL — the URL of your deployed dashboard
# Used by the backend to build correct redirect URLs
DASHBOARD_URL=http://localhost:3000


# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

# REQUIRED — a random secret used to verify webhook requests
# Generate one at: openssl rand -hex 32
# Or just mash your keyboard for 32 characters
WEBHOOK_SECRET=

# REQUIRED — a random secret for internal API auth
# Generate the same way as above
INTERNAL_API_SECRET=


# ============================================================
# QUICK START CHECKLIST
# ============================================================
#
# Before running the system, confirm:
#
# [ ] BUSINESS_NAME and BUSINESS_PHONE filled in
# [ ] VAPI_API_KEY, VAPI_ASSISTANT_ID, VAPI_WEBHOOK_SECRET filled in
# [ ] SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY filled in
# [ ] ANTHROPIC_API_KEY filled in
# [ ] TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER filled in
# [ ] GOOGLE_CALENDAR_ID and GOOGLE_SERVICE_ACCOUNT_FILE filled in
# [ ] WEBHOOK_SECRET and INTERNAL_API_SECRET filled in
# [ ] .env file is NOT committed to GitHub
#
# Once all boxes are checked — run: bash scripts/dev.sh
# ============================================================
